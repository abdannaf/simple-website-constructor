---
import Hero from '../assets/hero.jpg'
---

<section id="About" class="min-h-screen flex items-center px-6 bg-[#f0f0f0] md:px-16 lg:px-20 py-20">
  <div class="flex flex-col md:flex-row items-center gap-12 w-full">
    
    <!-- Kolom Kiri -->
    <div class="w-full md:w-1/2 flex flex-col gap-6">
      
      <!-- Heading -->
      <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 leading-tight">
        Welcome To Construction Real Solution.
      </h1>

      <!-- Subtitle -->
      <p class="text-gray-500 text-base leading-relaxed">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod 
        tempor incididunt ut labore et doloremagna aliqua. Ut enim ad minim veniam.
      </p>

      <!-- Checklist -->
      <ul class="flex flex-col gap-3">
        {[
          'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
          'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
          'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
          'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
        ].map((item) => (
          <li class="flex items-start gap-3 text-sm text-gray-600">
            <span class="mt-0.5 shrink-0 w-5 h-5 rounded-full border-2 border-amber-400 flex items-center justify-center">
              <svg class="w-3 h-3 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <!-- Button -->
      <div>
        <button class="flex items-center gap-2 px-6 py-3 bg-amber-400 text-gray-900 font-semibold rounded-md hover:bg-amber-500 transition-colors cursor-pointer ease-in duration-200">
          Read More
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 9l3 3m0 0l-3 3m3-3H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Kolom Kanan — Gambar dengan potongan melengkung -->
    <div class="w-full md:w-1/2 relative ">
      <div class="grid grid-cols-2 gap-3">
        
        <!-- Gambar besar kiri atas -->
        <div class="row-span-2 hover:-translate-y-2 transition duration-300 ease-in">
          <img 
            src={Hero.src} 
            alt="Construction site" 
            class="w-full h-full object-cover rounded-3xl hover:shadow-2xl duration-300 ease-in"
            style="min-height: 320px;"
          />
        </div>

        <!-- Gambar kanan atas -->
        <div class="hover:-translate-y-2 transition duration-300 ease-in">
          <img 
            src={Hero.src}  
            alt="Construction crane" 
            class="w-full object-cover rounded-3xl hover:shadow-2xl duration-300 ease-in"
            style="height: 150px;"
          />
        </div>

        <!-- Gambar kanan bawah -->
        <div class="hover:-translate-y-2 transition duration-300 ease-in">
          <img 
            src={Hero.src}
            alt="Construction ground" 
            class="w-full object-cover rounded-3xl hover:shadow-2xl duration-300 ease-in"
            style="height: 150px;"
          />
        </div>

        <div class="col-span-2 hover:-translate-y-2 transition duration-300 ease-in ">
            <img 
            src={Hero.src}
            alt="Construction ground" 
            class="w-full object-cover rounded-3xl hover:shadow-2xl ease-in duration-300"
            style="height: 150px;"
            />
        </div>

      </div>
    </div>

  </div>
</section>