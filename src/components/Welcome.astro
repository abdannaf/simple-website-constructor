---
import House from '../assets/download.jpg'
---


<section id="Welcome" class="font-Inter pt-6">
    <div class="min-h-screen flex flex-col md:flex-row items-center justify-center px-9 gap-10 z-10">
        <div class="md:w-[50%] pl-10 p-20">
            <h1 class="text-5xl font-bold text-black">Bangun Impian Anda Bersama Kami</h1>
                <p class="text-lg text-gray-600 mt-4">Dengan pengerjaan premium dan tim berpengalaman, kami membantu Anda membangun hunian yang tidak hanya indah, tapi juga kokoh dan tahan lama.
                </p>
                    <div class="mx-2.5">
                        <button class="font-poppins cursor-pointer mt-8 px-8 py-3 bg-amber-400 text-black font-bold rounded-lg border border-amber-400 hover:bg-white hover:border-amber-400 hover:text-amber-400 transition duration-300">
                            View Services
                        </button>
                    </div>
        </div>
            
        <div class="w-full md:w-[50%] flex items-center justify-center">
            <div class="md:items-center md:flex md:justify-center">
                <img src={House.src} class="w-full max-w-lg md:w-full rounded-2xl shadow-2xl" alt="dent-hero">
            </div>
        </div>
    </div>
</section>