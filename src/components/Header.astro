---
import Nav from "./Nav.astro"
---

<header id="navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-300">
  <nav class="flex justify-between items-center font-poppins px-6 md:px-10 py-4 md:py-6">
    <!-- Logo -->
    <div>
      <h1 class="font-bold text-2xl">Build<span class="text-amber-400">Pro</span></h1>
    </div>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">
      <Nav />
    </div>

    <!-- CTA Button -->
    <button class="hidden md:block px-5 py-2 cursor-pointer bg-amber-400 text-white rounded-md font-medium hover:bg-amber-500 transition-colors">
      Contact Us
    </button>

    <!-- Hamburger (Mobile) -->
    <button id="menu-toggle" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Toggle menu">
      <span class="block w-6 h-0.5 bg-current transition-all"></span>
      <span class="block w-6 h-0.5 bg-current transition-all"></span>
      <span class="block w-6 h-0.5 bg-current transition-all"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden px-6 pb-4 flex-col gap-4">
    <Nav />
    <button class="w-full px-5 py-2 cursor-pointer bg-amber-400 text-white rounded-md font-medium">
      Consultation
    </button>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  const addBlur = () =>
    navbar?.classList.add('bg-white/80', 'backdrop-blur-md', 'shadow-sm');

  const removeBlur = () =>
    navbar?.classList.remove('bg-white/80', 'backdrop-blur-md', 'shadow-sm');

  const isMobileMenuOpen = () => !mobileMenu?.classList.contains('hidden');

  // Scroll handler
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      addBlur();
    } else {
      // Kalau mobile menu masih terbuka, tetap blur walau balik ke atas
      if (!isMobileMenuOpen()) {
        removeBlur();
      }
    }
  });

  // Mobile menu toggle
  menuToggle?.addEventListener('click', () => {
    const isNowHidden = mobileMenu?.classList.toggle('hidden');

    if (!isNowHidden) {
      // Menu baru dibuka
      addBlur();
    } else {
      // Menu baru ditutup
      if (window.scrollY <= 20) {
        removeBlur();
      }
    }
  });
</script>